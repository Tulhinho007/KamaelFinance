# ==============================================================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE - KAMAEL FINANCE (EXEMPLO SEGURO)
# NUNCA insira senhas reais ou conexões de banco de produção neste arquivo.
# Copie este arquivo para ".env" no seu ambiente local e preencha com seus dados.
# ==============================================================================

# URL de conexão com o banco de dados PostgreSQL (Supabase / Neon / Local)
DATABASE_URL="postgresql://usuario:senha_aqui@localhost:5432/kamaelfinance?schema=public"
DIRECT_URL="postgresql://usuario:senha_aqui@localhost:5432/kamaelfinance?schema=public"

# Salt para Hashing de Senhas de Autenticação (Altere para uma chave aleatória e segura)
AUTH_SALT="sua_chave_salt_super_segura_2026"

# Chave Mestra para Recuperação de Senha do Administrador Master (opcional)
MASTER_RECOVERY_KEY="sua_chave_mestra_de_recuperacao_2026"

# ID do usuário padrão para modo de desenvolvimento (opcional)
DEV_USER_ID="00000000-0000-0000-0000-000000000000"

# Ambiente de execução (development / production)
NODE_ENV="development"
